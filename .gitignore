# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI (link local; no subir)
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright E2E artefactos locales
e2e-super-admin*.png

# ── La APK del asesor (Capacitor + Android) ────────────────────────────────
# El proyecto nativo SÍ va al repo: es lo que permite volver a compilar la APK.
# Lo que no va es lo que se genera al compilar, lo que apunta a una máquina en
# particular, y las credenciales de Firebase.
/android/app/build/
/android/build/
/android/.gradle/
/android/capacitor-cordova-android-plugins/build/
/android/local.properties
/android/app/google-services.json
# Capacitor la regenera en cada `cap sync` a partir de capacitor.config.ts.
/android/app/src/main/assets/capacitor.config.json
# Las APK no se versionan: se compilan.
*.apk
*.aab
# El keystore y sus contraseñas NUNCA van al repo.
*.keystore
*.jks
