# Neura ERP · Roldán e Hijos — vars mínimas para Coolify.
# NO commitear valores reales; este archivo es solo referencia.

# --- Identidad del tenant (fijas para este deploy) ---
NEURA_CLIENT_SCHEMA=roldanerp
NEURA_CLIENT_NAME=Roldán e Hijos
# `single_client` activa la allowlist estricta de módulos: `empresa_modulos` es
# la única fuente de verdad y los aliases legacy quedan inhabilitados.
NEURA_INSTANCE_MODE=single_client

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
DATABASE_URL=
DIRECT_URL=
PG_POOL_MAX=10

# --- SIFEN (facturación electrónica Paraguay) ---
# El certificado + password se guardan en DB (empresa_sifen_config), no acá.
SIFEN_SECRETS_KEY=
SIFEN_ID_CSC=
# Poner en "1" si querés apagar el worker que envía a la SET.
# SIFEN_WORKER_DISABLED=

# --- Super admin (emails separados por coma) ---
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=

# --- Facturación defaults ---
FACTURA_PREFIJO=001-001
FACTURA_DIAS_CREDITO_DEFAULT=30

# --- WhatsApp / Omnicanal (opcional; si no lo usan, dejar vacío) ---
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_EMPRESA_ID=
WHATSAPP_GRAPH_VERSION=v21.0

# --- Webhooks internos ---
WEBHOOK_SECRET=
WEBHOOK_URL=

# --- Otros ---
GOOGLE_CLOUD_VISION_API_KEY=
ALLOW_TEST_MODE=false
